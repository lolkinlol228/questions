# Copy this file to .env.local and fill values from Supabase Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Respondents do NOT need registration or login.
# Admin panel by default requires Supabase Auth login.
# If you set this to false, you must also enable the optional public SELECT policy in supabase.sql.
VITE_ADMIN_REQUIRE_AUTH=true

VITE_SURVEY_VERSION=3
